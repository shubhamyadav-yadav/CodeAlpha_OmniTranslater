# ===================================================
# Language Translation Tool - Environment Configuration
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Translation Provider
# Options: 'google' | 'mymemory' | 'libretranslate'
# Default: 'google' (high-accuracy neural machine translation out-of-the-box)
TRANSLATION_PROVIDER=google

# ---------------------------------------------------
# Provider: Google Cloud Translation API (v2)
# Required if TRANSLATION_PROVIDER=google
# ---------------------------------------------------
GOOGLE_TRANSLATE_API_KEY=YOUR_GOOGLE_CLOUD_API_KEY

# ---------------------------------------------------
# Provider: LibreTranslate API
# Required if TRANSLATION_PROVIDER=libretranslate
# ---------------------------------------------------
LIBRETRANSLATE_API_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=YOUR_LIBRETRANSLATE_API_KEY

# ---------------------------------------------------
# Provider: MyMemory Translation API
# Optional configuration for MyMemory
# Providing an email increases free rate limit to 50,000 words/day
# ---------------------------------------------------
MYMEMORY_EMAIL=
MYMEMORY_API_KEY=

# ---------------------------------------------------
# Rate Limiting & Input Validation
# ---------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_TEXT_LENGTH=5000
